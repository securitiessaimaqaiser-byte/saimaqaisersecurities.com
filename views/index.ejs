<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saima Qaiser Securities</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Header Partial -->
    <%- include('partials/header') %>

    <!-- Popup Partial -->
    <%- include('partials/popup') %>

    <!-- Main Content -->
    <main>
        <section class="hero">
            <h1>Welcome to Saima Qaiser Securities</h1>
            <p>Your trusted partner in investment and brokerage.</p>
            <a href="/auth/register" class="btn primary-btn">Get Started</a>
        </section>

        <section class="features">
            <div class="feature">
                <h3>Secure Trading</h3>
                <p>Trade confidently with state-of-the-art security measures.</p>
            </div>
            <div class="feature">
                <h3>Expert Advisors</h3>
                <p>Get insights from experienced market professionals.</p>
            </div>
            <div class="feature">
                <h3>Portfolio Management</h3>
                <p>Track your investments with ease and accuracy.</p>
            </div>
        </section>

        <section class="cta">
            <h2>Ready to grow your portfolio?</h2>
            <a href="/auth/register" class="btn secondary-btn">Join Now</a>
        </section>
    </main>

    <!-- Footer Partial -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
    <script src="/js/popup.js"></script>
</body>
</html>
