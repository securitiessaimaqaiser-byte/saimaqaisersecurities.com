<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Saima Qaiser Securities</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Header Partial -->
    <%- include('partials/header') %>

    <!-- Popup Partial -->
    <%- include('partials/popup') %>

    <!-- Main Content -->
    <main>
        <section class="dashboard-hero">
            <h1>Welcome, <%= user.name %>!</h1>
            <p>Manage your investments, track your portfolio, and view reports.</p>
        </section>

        <section class="dashboard-actions">
            <div class="card">
                <h3>Portfolio</h3>
                <p>View your current investments and their performance.</p>
                <a href="/dashboard/portfolio" class="btn secondary-btn">View Portfolio</a>
            </div>
            <div class="card">
                <h3>Transactions</h3>
                <p>Track your buy/sell orders and transaction history.</p>
                <a href="/dashboard/transactions" class="btn secondary-btn">View Transactions</a>
            </div>
            <div class="card">
                <h3>Profile</h3>
                <p>Update your account information and settings.</p>
                <a href="/dashboard/profile" class="btn secondary-btn">Edit Profile</a>
            </div>
        </section>
    </main>

    <!-- Footer Partial -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
    <script src="/js/popup.js"></script>
</body>
</html>
