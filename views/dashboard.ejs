<section class="dashboard-section">
    <div class="dashboard-container">

        <h2>Welcome to Your Dashboard</h2>

        <% if (user) { %>
            <div class="user-info">
                <p><strong>Name:</strong> <%= user.name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
                <p><strong>Member Since:</strong> <%= new Date(user.createdAt).toDateString() %></p>
            </div>
        <% } else { %>
            <p>You are not logged in.</p>
        <% } %>

        <div class="dashboard-actions">
            <a href="/dashboard/profile" class="btn primary-btn">View Profile</a>
            <a href="/dashboard/settings" class="btn secondary-btn">Account Settings</a>
            <a href="/auth/logout" class="btn danger-btn">Logout</a>
        </div>

        <div class="dashboard-content">
            <h3>Your Financial Overview</h3>
            <p>This section will display account balances, investment summaries, and activity logs in future updates.</p>
        </div>

    </div>
</section>
